# ============================================================
# 鲤慧 LiHui 服务端环境变量
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会上传）
# ============================================================

# ---------- 服务 ----------
PORT=8809
HOST=0.0.0.0
# 生产环境请设置为你的正式域名，用于 CORS
CORS_ORIGIN=*
LOG_LEVEL=info

# ---------- 百度地图（服务端 AK，绝不下发到客户端） ----------
BAIDU_AK=<你的百度服务端AK，百度控制台创建，类型=服务端>
#    ★ 多 AK 池（Key 掉线自愈）：支持逗号分隔多把钥匙，如 BAIDU_AK=ak1,ak2,ak3
#    某把钥匙日配额打满/被风控停用时，服务自动冷却它 10 分钟并切换下一把，
#    0 点配额重置后自动回归。诊断接口：GET /api/v1/map/ak-status
#    建议至少配 2 把（可在同一百度账号控制台创建多个「服务端」类型 AK）。
BAIDU_MAP_BASE=https://api.map.baidu.com
# 百度地图 Web 服务 API 默认返回 sn 校验关闭状态；如开启了 SN 校验请填 SK
BAIDU_SK=
# 浏览器端 AK(H5 底图 /map-home 专用):百度控制台单独创建「浏览器端」类型 AK,
# Referer 白名单锁定你的域名(如 *.lihui-tech.online/*)。泄露无害(白名单外调不通)、可独立重置。
# 留空时页面自动注入蜜罐 AK —— 扒页面的人拿到的是废钥匙。
BAIDU_AK_BROWSER=

# ---------- 安全与高并发(详见 src/utils/security.js) ----------
# 百度出站 QPS 上限(令牌桶):高并发时排队,防配额被瞬间打爆
BAIDU_QPS=30
# 蜜罐命中后的 IP 封禁时长(毫秒),默认 10 分钟
HONEYPOT_BAN_MS=600000
# ⚠️ 蜜罐密钥(honeytoken):下面这些是【故意放置的假密钥】,散布在 H5 页面与本模板中。
#    正常业务永远不该携带它们;谁拿它们请求本服务 → security.log 记录来源 + 封禁。
#    请勿删除,也【切勿】把它们填到 BAIDU_AK 等真实配置里(服务端会自检告警)。
#    示例(假):BAIDU_AK=vHk3mQ9pX2wR7tZ5nB8cL4dF6gS1aJ0e  ← 这把钥匙是假的
HONEYPOT_CANARY=vHk3mQ9pX2wR7tZ5nB8cL4dF6gS1aJ0e

# ---------- 大模型（留空则在端上「我的-模型设置」里配置） ----------
# 默认走 OpenAI 兼容协议，可指向 DeepSeek / 通义 / 智谱 / Ollama 等
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen-1.8B-instruct

# ---------- Token 配额 ----------
TOKEN_DAILY_QUOTA=200000

# ---------- MCP ----------
MCP_DIR=../04-lh-mcp-servers
MCP_AUTOSTART=true
MCP_MAX_RESTART=3

# ---------- 第三方语音（可选） ----------
VOICE_BAIDU_API_KEY=
VOICE_BAIDU_SECRET_KEY=
VOICE_AZURE_KEY=
VOICE_AZURE_REGION=eastasia
