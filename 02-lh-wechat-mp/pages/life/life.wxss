.lh-page {
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(180deg, #EAF2FF 0%, #F4F5F7 100%);
  padding: 32rpx 32rpx 16rpx;
}
.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.hero-sub {
  margin-top: 8rpx;
}
.care {
  font-size: 24rpx;
  color: #646A73;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.care.on {
  color: #1677FF;
  font-weight: 600;
  background: #EAF2FF;
}

.score-box {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}
.loading-box {
  min-height: 256rpx;
  justify-content: center;
}
.ring {
  width: 256rpx;
  height: 256rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.ring-inner {
  width: 216rpx;
  height: 216rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-score {
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1;
}
.ring-unit {
  font-size: 24rpx;
  color: #8F959E;
  margin-top: 4rpx;
}
.score-right {
  flex: 1;
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
}
.mini-btn {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.cat-card {
  margin: 24rpx 32rpx 0;
}
.lh-card {
  margin: 24rpx 32rpx 0;
}
.cat-row {
  margin-top: 28rpx;
}
.cat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cat-name {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
}
.cat-score {
  font-size: 30rpx;
  font-weight: 600;
}
.bar-bg {
  height: 12rpx;
  background: #EDEFF2;
  border-radius: 6rpx;
  margin-top: 16rpx;
  overflow: hidden;
}
.bar-fg {
  height: 12rpx;
  border-radius: 6rpx;
}
.cat-desc {
  font-size: 24rpx;
  color: #646A73;
  margin-top: 12rpx;
  display: block;
}
.warn-row {
  display: flex;
  margin-top: 20rpx;
}
.warn-dot {
  color: #F5222D;
  font-size: 20rpx;
  margin: 12rpx 16rpx 0 0;
}
.warn-text {
  flex: 1;
}
.tip-row {
  display: flex;
  margin-top: 20rpx;
}
.tip-idx {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #EAF2FF;
  color: #1677FF;
  font-size: 24rpx;
  font-weight: 600;
  margin: 4rpx 16rpx 0 0;
  flex-shrink: 0;
}
.tip-text {
  flex: 1;
}
.mt24 {
  margin-top: 24rpx;
}
.ghost-btn {
  margin-top: 32rpx;
}

.rate-input {
  display: flex;
  margin-top: 24rpx;
}
.rate-inp {
  flex: 1;
  height: 88rpx;
  background: #F4F5F7;
  border-radius: 999rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
}
.ph {
  color: #8F959E;
}
.rate-btn {
  width: 176rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-left: 16rpx;
  font-size: 30rpx;
}
.rate-dim {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}
.dim-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  display: block;
}
.dim-hint {
  font-size: 26rpx;
  color: #646A73;
  margin-top: 4rpx;
  display: block;
}
.rate-advice {
  margin-top: 24rpx;
  background: #F8F9FB;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}
.pref-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}
.pref-tags {
  display: flex;
}
.pref-tags .lh-pill {
  margin-left: 16rpx;
}

/* ---------------- 步行等时圈 + 服务盲区 ---------------- */
.iso-card .iso-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.iso-mins {
  display: flex;
  gap: 10rpx;
}
.iso-min {
  font-size: 22rpx;
  color: #646a73;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.iso-min.on {
  color: #1677ff;
  background: #e8f2ff;
  font-weight: 600;
}
.iso-loading {
  padding: 40rpx 0;
  text-align: center;
}
.iso-map {
  width: 100%;
  height: 460rpx;
  border-radius: 16rpx;
  margin-top: 18rpx;
}
.iso-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}
.iso-stat {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 14rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.iso-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.3;
}
.iso-num.good { color: #00b96b; }
.iso-num.bad { color: #f5222d; }
.iso-lab {
  font-size: 20rpx;
  color: #8f959e;
  margin-top: 4rpx;
  text-align: center;
}
.iso-legend {
  margin-top: 16rpx;
}
.lg-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 0;
}
.lg-sw {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
}
.lg-iso { background: rgba(22, 119, 255, 0.12); border: 2rpx solid #1677ff; }
.lg-blind { background: rgba(245, 63, 63, 0.3); border: 2rpx solid #f53f3f; }
.lg-eng { background: #e8f2ff; border: 2rpx solid #bad9ff; }
.lg-eng.warn { background: #fff7e6; border-color: #ffe7ba; }
.iso-entry {
  padding: 10rpx 0 6rpx;
}
.iso-go {
  margin-top: 18rpx;
}
