# ---------- 依赖 ----------
node_modules/
**/node_modules/

# ---------- 密钥与环境变量（绝不入库） ----------
.env
**/.env
!*.env.example

# ---------- 服务端运行时数据（日志 / Token 账本 / 反馈） ----------
# 注意：models.json（模型 Key）由 03-lh-server/.gitignore 挡住，【永不入库】——
#      云端由 seed() 首次启动自动生成，Key 走云托管控制台环境变量注入
#      （MODELSCOPE_TOKEN / SILICONFLOW_API_KEY）。这里逐一排除其余运行时文件。
03-lh-server/data/feedback.json
03-lh-server/data/logs/
03-lh-server/data/mcp.json
03-lh-server/data/quota.json
03-lh-server/data/sessions.json
03-lh-server/data/tokens.json
03-lh-server/data/voice.json
03-lh-server/data/orders.json
# 真实店源目录：运行时由百度 POI 同步生成（near/hot 各一份），不入库（Dockerfile 也不 COPY，容器内会重新拉）
03-lh-server/data/catalog*.json
# POI 结果兜底缓存：仅在百度配额挂掉时回吐上次结果，不入库
03-lh-server/data/poi.json

# ---------- 日志 ----------
*.log
logs/

# ---------- uni-app / 小程序编译产物 ----------
unpackage/
**/unpackage/dist/

# 微信开发者工具本地生成的多端 i18n 信息（随开发者账号变化，非源码）
miniapp/

# ---------- IDE / 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------- WorkBuddy 会话数据（本地工具，不入库） ----------
.workbuddy/

# 地址补查运行时数据（用户提交的地址，云端自行生成，不入库）
03-lh-server/data/addr-fixes.json

# 用户画像运行时数据（自动学习的用户习惯，云端自行生成，不入库）
03-lh-server/data/profiles.json
