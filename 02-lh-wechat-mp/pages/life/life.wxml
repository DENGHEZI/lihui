<view class="lh-page {{careMode ? 'care-mode' : ''}} {{theme === 'dark' ? 'theme-dark' : ''}}">
  <view class="hero">
    <view class="hero-top">
      <view>
        <text class="lh-h1">15 分钟生活圈体检</text>
        <text class="lh-cap hero-sub">{{centerText}} · 步行半径 {{radius}} 米</text>
      </view>
      <view class="care {{careMode ? 'on' : ''}}" bindtap="toggleCare">{{careMode ? '关怀模式' : '标准模式'}}</view>
    </view>

    <view class="score-box" wx:if="{{report}}">
      <view class="ring" style="background: conic-gradient({{ringColor}} {{ringDeg}}deg, var(--lh-line) 0deg)">
        <view class="ring-inner">
          <text class="ring-score" style="color:{{ringColor}}">{{report.score}}</text>
          <text class="ring-unit">分</text>
        </view>
      </view>
      <view class="score-right">
        <text class="lh-cap">短板 {{report.shortboards.length}} 项</text>
        <text class="lh-mini">预计步行 {{report.walkMinutes}} 分钟可达</text>
        <button class="lh-btn mini-btn" bindtap="customize">生成我的生活圈方案</button>
      </view>
    </view>
    <view class="score-box loading-box" wx:else>
      <text class="lh-cap">正在体检…</text>
    </view>
    <view class="std-ref" wx:if="{{standardName}}" bindtap="toggleStdDetail">
      <text class="std-ref-badge">依据</text>
      <text class="std-ref-text">{{standardName}}{{standardCoverage ? ' · 15分钟步行覆盖率目标 ' + standardCoverage + '%'}} · {{standardIssuer}}</text>
    </view>
    <view class="std-detail" wx:if="{{showStdDetail && standardQuote}}">
      <text class="lh-mini">{{standardQuote}}</text>
    </view>
  </view>

  <view class="lh-card cat-card" wx:if="{{report}}">
    <view class="radar-head">
      <text class="lh-h2">六类设施覆盖</text>
      <text class="lh-mini">雷达图 · 各维度 0-100 分</text>
    </view>
    <canvas type="2d" id="radar" class="radar-canvas"></canvas>
    <view class="cat-row" wx:for="{{report.categories}}" wx:key="key">
      <view class="cat-head">
        <text class="cat-name">{{item.name}}</text>
        <text class="cat-score" style="color:{{item.color}}">{{item.score}}</text>
      </view>
      <view class="bar-bg">
        <view class="bar-fg" style="width:{{item.score}}%;background:{{item.color}}"></view>
      </view>
      <text class="cat-desc">{{item.desc}} · 可达 {{item.count}} 处{{item.nearestText}}</text>
    </view>
  </view>

  <!-- 步行等时圈 + 服务盲区 -->
  <view class="lh-card iso-card">
    <view class="iso-head">
      <text class="lh-h2">步行等时圈 · 服务盲区</text>
      <view class="iso-mins">
        <text
          class="iso-min {{isoMinutes === item ? 'on' : ''}}"
          wx:for="{{[15, 30, 45, 60]}}"
          wx:key="*this"
          bindtap="onIsoMinutes"
          data-m="{{item}}"
        >{{item}}分</text>
      </view>
    </view>

    <view wx:if="{{isoLoading}}" class="iso-loading">
      <text class="lh-cap">正在沿真实路网计算 {{isoMinutes}} 分钟步行等时圈…</text>
    </view>

    <block wx:if="{{iso && !isoLoading}}">
      <map
        class="iso-map"
        longitude="{{isoCenter.lng}}"
        latitude="{{isoCenter.lat}}"
        scale="{{isoScale}}"
        polygons="{{isoPolygons}}"
        markers="{{isoMarkers}}"
        show-location
        enable-rotate="{{false}}"
      ></map>

      <view class="iso-stats">
        <view class="iso-stat">
          <text class="iso-num {{iso.coverageScore >= 60 ? 'good' : (iso.coverageScore < 40 ? 'bad' : '')}}">{{iso.coverageScore}}</text>
          <text class="iso-lab">覆盖加权分</text>
        </view>
        <view class="iso-stat">
          <text class="iso-num {{iso.summary.blindCount > 0 ? 'bad' : 'good'}}">{{iso.summary.blindCount}}/{{iso.summary.gridInside}}</text>
          <text class="iso-lab">盲区格（{{iso.summary.blindRatio}}%）</text>
        </view>
        <view class="iso-stat">
          <text class="iso-num">{{iso.summary.circleAreaKm2}}km²</text>
          <text class="iso-lab">等时圈面积</text>
        </view>
        <view class="iso-stat">
          <text class="iso-num">{{iso.summary.maxReachM >= 1000 ? iso.summary.maxReachM / 1000 + 'km' : iso.summary.maxReachM + 'm'}}</text>
          <text class="iso-lab">最远可达</text>
        </view>
      </view>

      <view class="iso-legend">
        <view class="lg-row"><view class="lg-sw lg-iso"></view><text class="lh-mini">步行等时圈（步速 {{iso.walkSpeed}}m/min × 路网弯曲 {{iso.detourFactor}}）</text></view>
        <view class="lg-row"><view class="lg-sw lg-blind"></view><text class="lh-mini">服务盲区格（覆盖分 &lt; 40，矩阵实测复核）</text></view>
        <view class="lg-row"><view class="lg-sw lg-eng {{iso.degraded ? 'warn' : ''}}"></view><text class="lh-mini">引擎：{{iso.engine}}{{iso.hint ? ' · ' + iso.hint : ''}}</text></view>
      </view>

      <!-- 服务盲区识别 · 分析面板（工业级指标） -->
      <view class="blind-panel" wx:if="{{iso.analysis}}">
        <view class="bp-cards">
          <view class="bp-card">
            <text class="bp-num {{iso.summary.blindRatio >= 30 ? 'bad' : iso.summary.blindRatio >= 15 ? 'warn' : 'good'}}">{{iso.summary.blindRatio}}<text class="bp-unit">%</text></text>
            <text class="bp-lab">盲区点位占比</text>
          </view>
          <view class="bp-card">
            <text class="bp-num">{{iso.analysis.blindAreaHa}}<text class="bp-unit">ha</text></text>
            <text class="bp-lab">盲区面积</text>
          </view>
          <view class="bp-card">
            <text class="bp-num">{{iso.analysis.detourIndex}}</text>
            <text class="bp-lab">绕行系数</text>
          </view>
        </view>

        <view class="bp-sect" wx:if="{{gapRows.length}}">
          <text class="bp-sect-t">分类缺口 · 盲区格里该类步行超时的比例</text>
        </view>
        <view class="bp-gap" wx:for="{{gapRows}}" wx:key="key">
          <text class="bp-gap-name">{{item.name}}</text>
          <view class="bp-gap-bar"><view class="bp-gap-fg {{item.level}}" style="width:{{item.gapPct}}%"></view></view>
          <text class="bp-gap-pct">{{item.gapPct}}%</text>
        </view>

        <block wx:if="{{iso.analysis.hotspots.length}}">
          <view class="bp-sect">
            <text class="bp-sect-t">优先改造地块 · 按面积 × 缺口强度排序</text>
          </view>
          <view class="bp-hot" wx:for="{{iso.analysis.hotspots}}" wx:key="index">
            <view class="bp-hot-rank {{index === 0 ? 'top' : ''}}">{{index + 1}}</view>
            <view class="bp-hot-mid">
              <text class="bp-hot-l1">{{item.areaHa}} 公顷 · {{item.cells}} 格 · 均分 {{item.avgScore}}</text>
              <text class="bp-hot-l2">最近设施步行约 {{item.avgNearestWalkMin}} 分钟</text>
            </view>
            <text class="bp-hot-go" catchtap="navToHotspot" data-i="{{index}}">导航</text>
          </view>
        </block>

        <text class="bp-method">{{iso.analysis.method}}</text>
      </view>
    </block>

    <view wx:if="{{!iso && !isoLoading}}" class="iso-entry">
      <text class="lh-cap">不止直线圆 —— 沿真实路网算出你步行 {{isoMinutes}} 分钟能到哪，并标出设施覆盖不到的盲区</text>
      <button class="lh-btn iso-go" bindtap="loadIsochrone">生成我的步行等时圈</button>
    </view>
  </view>

  <view class="lh-card" wx:if="{{report.shortboards.length}}">
    <text class="lh-h2">短板提醒</text>
    <view class="warn-row" wx:for="{{report.shortboards}}" wx:key="*this">
      <text class="warn-dot">●</text>
      <text class="lh-body warn-text">{{item}}</text>
    </view>
    <view class="lh-divider mt24"></view>
    <text class="lh-h2 mt24">补齐建议</text>
    <view class="tip-row" wx:for="{{report.suggestions}}" wx:key="*this">
      <text class="tip-idx">{{index + 1}}</text>
      <text class="lh-body tip-text">{{item}}</text>
    </view>
  </view>

  <view class="lh-card" wx:if="{{plan}}">
    <text class="lh-h2">个性化生活圈方案</text>
    <view class="tip-row" wx:for="{{plan.plan}}" wx:key="*this">
      <text class="tip-idx">{{index + 1}}</text>
      <text class="lh-body tip-text">{{item}}</text>
    </view>
    <button class="lh-btn lh-btn--ghost ghost-btn" bindtap="jumpMap">在地图上查看</button>
  </view>

  <view class="lh-card">
    <text class="lh-h2">服务质量评价参考</text>
    <text class="lh-cap">输入常去的商家或机构名称，看看值不值得去</text>
    <view class="rate-input">
      <input class="rate-inp" value="{{rateName}}" placeholder="如：岳麓区社区卫生服务中心" placeholder-class="ph" bindinput="onRateInput" />
      <button class="lh-btn rate-btn" bindtap="doRate">评估</button>
    </view>
    <view wx:if="{{rateResult}}">
      <view class="rate-dim" wx:for="{{rateResult.dimensions}}" wx:key="name">
        <text class="dim-name">{{item.name}}</text>
        <text class="dim-hint">{{item.hint}}</text>
      </view>
      <text class="lh-body rate-advice">{{rateResult.advice}}</text>
    </view>
  </view>

  <view class="lh-card">
    <text class="lh-h2">生活圈偏好</text>
    <view class="pref-row">
      <text class="lh-body">预算水平</text>
      <view class="pref-tags">
        <text
          class="lh-pill {{pref.budget === item.key ? 'lh-pill--on' : ''}}"
          wx:for="{{budgets}}"
          wx:key="key"
          bindtap="setBudget"
          data-i="{{index}}"
        >{{item.name}}</text>
      </view>
    </view>
    <view class="pref-row">
      <text class="lh-body">家里有老人</text>
      <switch checked="{{pref.withElderly}}" color="#1677FF" bindchange="onElderly" />
    </view>
    <view class="pref-row">
      <text class="lh-body">需要公园</text>
      <switch checked="{{pref.needPark}}" color="#1677FF" bindchange="onPark" />
    </view>
    <view class="pref-row">
      <text class="lh-body">最长步行时间</text>
      <text class="lh-cap">{{pref.maxWalkMinutes}} 分钟</text>
    </view>
    <slider value="{{pref.maxWalkMinutes}}" min="5" max="60" step="5" activeColor="#1677FF" bindchange="onWalk" />
  </view>

  <view style="height: 64rpx"></view>
</view>
