<view class="lh-page">
  <!-- 模型 -->
  <view class="lh-card">
    <view class="head">
      <text class="lh-h2">我的模型 / API</text>
      <text class="add" bindtap="openEditor" data-i="-1">+ 添加</text>
    </view>
    <text class="lh-cap">支持 OpenAI 兼容 / DeepSeek / Anthropic / Gemini / Ollama，Key 只存在你自己的服务端。</text>

    <view class="model-row {{item.isDefault ? 'on' : ''}}" wx:for="{{models}}" wx:key="id">
      <view class="m-mid" bindtap="setDefault" data-id="{{item.id}}">
        <view class="m-name-row">
          <text class="m-name">{{item.name}}</text>
          <text class="m-badge" wx:if="{{item.isDefault}}">使用中</text>
          <text class="m-badge off" wx:elif="{{!item.enabled}}">已停用</text>
        </view>
        <text class="m-meta">{{item.provider}} · {{item.model}}</text>
        <text class="m-meta">{{item.baseUrl || '（默认地址）'}} · Key {{item.apiKey || '未设置'}}</text>
      </view>
      <view class="m-ops">
        <text class="op" bindtap="testItem" data-id="{{item.id}}">测试</text>
        <text class="op" bindtap="openEditor" data-i="{{index}}">编辑</text>
      </view>
    </view>
  </view>

  <!-- 语音 -->
  <view class="lh-card">
    <text class="lh-h2">自定义语音</text>
    <text class="lh-cap">选择音色、语速、方言；老年人可开启关怀模式自动放慢加响。</text>

    <view class="row">
      <text class="lh-body">语音引擎</text>
      <picker range="{{engineNames}}" value="{{engineIndex}}" bindchange="onEngine">
        <text class="pick">{{engineNames[engineIndex]}} ▾</text>
      </picker>
    </view>
    <view class="row">
      <text class="lh-body">音色</text>
      <picker range="{{speakerNames}}" value="{{speakerIndex}}" bindchange="onSpeaker">
        <text class="pick">{{speakerNames[speakerIndex]}} ▾</text>
      </picker>
    </view>
    <view class="row">
      <text class="lh-body">方言</text>
      <picker range="{{dialectNames}}" value="{{dialectIndex}}" bindchange="onDialect">
        <text class="pick">{{dialectNames[dialectIndex]}} ▾</text>
      </picker>
    </view>

    <view class="slider-row">
      <text class="lh-body">语速 {{voice.speed}}</text>
      <slider value="{{speedVal}}" min="25" max="100" activeColor="#1677FF" bindchange="onSpeed" />
    </view>
    <view class="slider-row">
      <text class="lh-body">音调 {{voice.pitch}}</text>
      <slider value="{{pitchVal}}" min="25" max="100" activeColor="#1677FF" bindchange="onPitch" />
    </view>
    <view class="slider-row">
      <text class="lh-body">音量 {{voice.volume}}</text>
      <slider value="{{volumeVal}}" min="0" max="75" activeColor="#1677FF" bindchange="onVolume" />
    </view>

    <view class="row">
      <text class="lh-body">唤醒词（预留）</text>
      <input class="row-inp" value="{{voice.wakeWord}}" placeholder="如：小鲤小鲤" placeholder-class="ph" bindblur="onWakeWord" />
    </view>
    <text class="lh-mini">说明：唤醒词为预留配置（小程序系统限制无法后台常驻监听）。方言播报需在服务端配置百度语音密钥后生效；端上兜底播报为普通话。</text>
    <view class="row">
      <text class="lh-body">自动播报结果</text>
      <switch checked="{{voice.autoSpeak}}" color="#1677FF" bindchange="onAutoSpeak" />
    </view>
    <view class="row">
      <text class="lh-body">关怀模式（老年人）</text>
      <switch checked="{{voice.careMode}}" color="#1677FF" bindchange="onCare" />
    </view>

    <button class="lh-btn lh-btn--ghost" bindtap="trySpeak">试听一下</button>
  </view>

  <!-- 高级 -->
  <view class="lh-card">
    <text class="lh-h2">高级</text>
    <view class="row">
      <text class="lh-body">当前套餐</text>
      <view class="plans">
        <text class="lh-pill {{plan === 'free' ? 'lh-pill--on' : ''}}" bindtap="setFree">免费基础版</text>
        <text class="lh-pill {{plan === 'pro' ? 'lh-pill--on' : ''}}" bindtap="setPro">增强版</text>
      </view>
    </view>
    <view class="row">
      <text class="lh-body">MCP 工具</text>
      <text class="lh-cap" bindtap="showMcp">查看可用工具 ›</text>
    </view>
    <view class="row">
      <text class="lh-body">推荐平台直达</text>
      <view class="plans">
        <text class="lh-pill" bindtap="jumpPlatform" data-app="美团外卖">🛵 美团外卖</text>
        <text class="lh-pill" bindtap="jumpPlatform" data-app="饿了么">🍜 饿了么</text>
        <text class="lh-pill" bindtap="jumpPlatform" data-app="滴滴出行">🚕 滴滴出行</text>
      </view>
    </view>
    <text class="lh-mini">增强版会调用 MCP 工具（成本优化、情感疏通、桌面操作等），Token 消耗更高。</text>
  </view>

  <!-- 编辑弹层 -->
  <view class="mask" wx:if="{{editor.show}}" bindtap="closeEditor">
    <view class="editor" catchtap="noop">
      <text class="lh-h2">{{editor.id ? '编辑模型' : '添加模型'}}</text>
      <view class="e-row">
        <text class="lh-cap">显示名称</text>
        <input class="e-inp" value="{{editor.name}}" placeholder="如：我的通义千问" placeholder-class="ph" data-k="name" bindinput="onEditInput" />
      </view>
      <view class="e-row">
        <text class="lh-cap">协议类型</text>
        <picker range="{{providerNames}}" value="{{providerIndex}}" bindchange="onProvider">
          <text class="pick">{{providerNames[providerIndex]}} ▾</text>
        </picker>
      </view>
      <view class="e-row">
        <text class="lh-cap">Base URL</text>
        <input class="e-inp" value="{{editor.baseUrl}}" placeholder="https://…/v1" placeholder-class="ph" data-k="baseUrl" bindinput="onEditInput" />
      </view>
      <view class="e-row">
        <text class="lh-cap">API Key</text>
        <input class="e-inp" value="{{editor.apiKey}}" placeholder="sk-…" placeholder-class="ph" password data-k="apiKey" bindinput="onEditInput" />
      </view>
      <view class="e-row">
        <text class="lh-cap">模型名</text>
        <input class="e-inp" value="{{editor.model}}" placeholder="如 qwen-plus / deepseek-chat" placeholder-class="ph" data-k="model" bindinput="onEditInput" />
      </view>
      <view class="e-ops">
        <button class="lh-btn lh-btn--ghost half" bindtap="closeEditor">取消</button>
        <button class="lh-btn half" bindtap="saveItem">保存</button>
      </view>
    </view>
  </view>

  <view style="height: 64rpx"></view>
</view>
