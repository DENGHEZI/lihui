# 依赖
node_modules/

# 环境变量（含 AK / Key，禁止提交）
.env
.env.local

# 运行数据
data/logs/
data/sessions/
data/tts/
data/tmp/
# 容器内 Memory 学习记忆(仓库根的 memory/ 才是正式记忆,入Git)
data/memory/

# 系统
.DS_Store
Thumbs.db
*.log
data/models.json

# SQLite 数据库（LH_STORE=sqlite 的运行时库，WAL 伴生文件一并忽略）
data/*.db
data/*.db-wal
data/*.db-shm

# RBAC 运行时数据（首启自动播种默认管理员，无需入库；含凭据，禁止提交）
data/users.json
# 蜜罐/IP 封禁运行时状态（重启即清，禁止提交）
data/security-bans.json
# Memory 人机协同运行时产出（非仓库根 memory/ 的正式记忆）
data/memory-learnings.json
data/memory-suggestions.json
