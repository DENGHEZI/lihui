# ============================================================
# 鲤慧 LiHui · 云托管部署专用环境变量
#
# ⚠️ 这个文件会随代码提交到 Gitee —— 因为云托管是从代码仓库拉代码构建镜像的，
#    如果放在 .gitignore 里（如 .env），构建时 COPY 不到文件，会直接构建失败。
#    本地开发仍然用 .env（已被忽略，不入库）。
#
# LLM_API_KEY 不在本文件里 —— 它在 data/models.json（同样需要入库，见 .gitignore）。
# ============================================================

# ---------- 服务 ----------
PORT=80
HOST=0.0.0.0
CORS_ORIGIN=*
LOG_LEVEL=info

# ---------- 百度地图（服务端 AK） ----------
BAIDU_AK=yQiUoVJ9TkQfVreTfGH7ZaKCaDnSaZQq
BAIDU_MAP_BASE=https://api.map.baidu.com

# ---------- 识图（百度千帆 ERNIE-4.5-VL，主通道） ----------
# 形态一（推荐）：控制台「安全认证」页复制的完整串（bce-v3/ALTAK-xx/xx），直接当 Bearer
# QIANFAN_API_KEY=bce-v3/ALTAK-xxxxxxxx/xxxxxxxx
# 形态二：千帆应用 API Key + Secret Key（OAuth 换 access_token，30 天有效自动缓存）
# ⚠️ 实测：这对 AK/SK 有「图像识别」REST 权限（advanced_general）；千帆对话 VL 无权限
QIANFAN_AK=2p1rKK0gPEKEndPr6e06xMLF
QIANFAN_SK=wreNkrCFlSO4Jszc26nufNFZgZne7HfK

# ---------- 大模型（Key 见 data/models.json） ----------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash

# ---------- Token 配额 ----------
TOKEN_DAILY_QUOTA=200000

# ---------- MCP ----------
MCP_AUTOSTART=true
