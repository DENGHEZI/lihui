# ============================================================
# 鲤慧 LiHui · Docker 部署环境变量（docker compose 自动读取本文件）
#
# 用法：cp .env.example .env  然后修改，最后 docker compose up -d --build
# 注意：本文件不含密钥，.env 才是真正填值的地方（.env 已被 .gitignore 忽略）
# ============================================================

# ---------- 必填：百度地图服务端 AK（服务端专用，不下发客户端） ----------
BAIDU_AK=

# ---------- 强烈建议：云端大模型（阿里云百炼 DashScope 兼容模式）----------
# 填上后 /model/active 会显示云端模型，并自动开启联网检索（解决公交/新闻等实时信息）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-flash

# ---------- 运行参数 ----------
# NODE_ENV / HOST / PORT / CORS_ORIGIN 已有默认值，一般不用改
# HOST=0.0.0.0
# PORT=8809
# CORS_ORIGIN=*

# MCP Server 是否随服务启动自动拉起（默认 true）
MCP_AUTOSTART=true

# 每日 Token 配额
TOKEN_DAILY_QUOTA=200000

# ---------- 存储与分布式部署（2026-10-06） ----------
# 存储驱动：json（默认，data/*.json 单文件，单实例零改动）
#           sqlite（Node 22.13+ 内置 node:sqlite，零 npm 依赖；单机多进程/多实例共享状态必开）
# 首次切 sqlite 会自动把 data/*.json 存量幂等导入数据库，业务无感
LH_STORE=json
# sqlite 库文件路径（默认 data/lihui.db；多实例共享卷部署时指向挂载点）
# LH_DB_PATH=/app/data/lihui.db
# 单机多进程 worker 数（默认 1；>1 必须配合 LH_STORE=sqlite）
# LH_WORKERS=1
