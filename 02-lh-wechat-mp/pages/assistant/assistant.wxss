.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}
.scene-bar {
  white-space: nowrap;
  background: var(--lh-card);
  padding: 16rpx 0 8rpx;
  border-bottom: 1rpx solid #EDEFF2;
}
.scene-list {
  display: inline-flex;
  padding: 0 24rpx;
}
.scene-pill {
  margin-right: 16rpx;
  white-space: nowrap;
}
.msgs {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}
.msg-row {
  display: flex;
  margin-bottom: 28rpx;
}
.msg-row.user {
  flex-direction: row-reverse;
}
.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3A8BFF, #1677FF);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.bubble {
  max-width: 78%;
  background: var(--lh-card);
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .05);
}
.bubble.user {
  background: #1677FF;
}
.bubble.user .txt {
  color: #FFFFFF;
}
.txt {
  font-size: 30rpx;
  line-height: 1.55;
  color: #1A1A1A;
  word-break: break-all;
  display: block;
}
.cards {
  margin-top: 20rpx;
}
.card {
  background: var(--lh-bg);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.c-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}
.c-sub {
  font-size: 24rpx;
  color: #646A73;
  margin-top: 8rpx;
  display: block;
}
.c-line {
  font-size: 24rpx;
  color: #646A73;
  margin-top: 8rpx;
  display: block;
  line-height: 1.5;
}
.c-save {
  font-size: 26rpx;
  color: #00B96B;
  font-weight: 600;
  margin-top: 12rpx;
  display: block;
}
.c-poi-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}
.c-poi-row:last-child {
  border-bottom: none;
}
.p-name {
  font-size: 26rpx;
  color: #1A1A1A;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.p-dist {
  font-size: 24rpx;
  color: #1677FF;
  margin-left: 16rpx;
}
.confirm-btn {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}
.actions {
  margin-top: 20rpx;
}
.act-btn {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.meta {
  margin-top: 16rpx;
}
.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--lh-card);
  border-top: 1rpx solid #EDEFF2;
}
/* 圆形工具钮（📷 识图 / 🎙 语音） */
.round-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--lh-primary-soft, #EAF2FF);
  border: 1rpx solid var(--lh-glass-line, rgba(22, 119, 255, 0.10));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.round-btn--hover { opacity: 0.75; }
.r-ico { font-size: 32rpx; line-height: 1; }
/* 关怀模式：右上角悬浮开关（低频操作不占输入栏） */
.care-fab {
  position: fixed;
  top: 16rpx;
  right: 24rpx;
  z-index: 60;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16rpx);
  border: 1rpx solid #E7EAEE;
  color: #646A73;
  font-size: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.08);
}
.care-fab.on {
  background: rgba(22, 119, 255, 0.92);
  border-color: transparent;
  color: #FFFFFF;
  font-weight: 600;
}
.chat-input {
  flex: 1;
  height: 76rpx;
  background: var(--lh-bg);
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
}
.ph {
  color: #8F959E;
}
/* 语音录音中：红底脉动 */
.mic-btn--rec {
  background: #F5222D;
  border-color: transparent;
  animation: micPulse 1.1s ease-in-out infinite;
}
/* 圆形渐变发送钮（ChatGPT/Linear 风格） */
.send-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1677FF, #4F8DFF);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.32);
  transition: transform 0.15s ease;
}
.send-btn--hover { transform: scale(0.94); }
.send-ico { font-size: 40rpx; font-weight: 700; line-height: 1; }
.send-btn.dis {
  background: #C8CDD4;
  box-shadow: none;
}

/* 录音状态条 */
.rec-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 32rpx;
  background: var(--lh-warning-soft);
  border-top: 1rpx solid var(--lh-warn-border);
}
.rec-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FA8C16;
  animation: rec-blink 1s infinite;
  flex-shrink: 0;
}
@keyframes rec-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}
.rec-text {
  font-size: 28rpx;
  color: #874D00;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 麦克风/识图按钮（对话栏语音+拍照） ----------
   尺寸统一由 .round-btn（76rpx 圆钮）控制，此处只保留录音态与悬停态 */
.mic-btn--hover { opacity: 0.75; }
.mic-btn--rec {
  background: var(--lh-danger-soft, rgba(245, 34, 45, 0.12));
  border-color: var(--lh-danger);
  animation: micPulse 1.1s ease-in-out infinite;
}
@keyframes micPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}

/* ---------- 录音浮层 ---------- */
.rec-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 16, 28, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 90;
}
.rec-card {
  width: 100%;
  background: var(--lh-card-solid);
  border-radius: 28rpx 28rpx 0 0;
  padding: 44rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}
.rec-wave { display: flex; align-items: center; gap: 10rpx; height: 60rpx; }
.rec-bar {
  width: 8rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: var(--lh-primary);
  animation: waveBar 0.9s ease-in-out infinite;
}
.rec-bar:nth-child(2) { animation-delay: 0.12s; }
.rec-bar:nth-child(3) { animation-delay: 0.24s; }
.rec-bar:nth-child(4) { animation-delay: 0.36s; }
.rec-bar:nth-child(5) { animation-delay: 0.48s; }
@keyframes waveBar {
  0%, 100% { height: 20rpx; opacity: 0.55; }
  50% { height: 56rpx; opacity: 1; }
}
.rec-text {
  min-height: 44rpx;
  font-size: 30rpx;
  color: var(--lh-text);
  text-align: center;
  line-height: 1.55;
  max-width: 100%;
}
.rec-stop {
  padding: 16rpx 72rpx;
  border-radius: 999rpx;
  background: var(--lh-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
.rec-stop--hover { opacity: 0.85; }

/* ---------- 识图按钮（📷 多模态）与图片气泡 ----------
   注：📷/🎙 按钮统一由 .round-btn 控制（80rpx 圆钮），此处不再重复定义 */
.msg-img {
  width: 340rpx;
  height: 250rpx;
  border-radius: 16rpx;
  display: block;
  margin-bottom: 10rpx;
  border: 1rpx solid var(--lh-glass-line, rgba(0, 0, 0, 0.06));
  background: var(--lh-primary-soft, #F0F3F8);
}

/* ---------- 语音播放按钮（🔊 每条助手回复可手动播报） ---------- */
.tts-row {
  display: flex;
  margin-top: 12rpx;
}
.tts-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--lh-primary, #1677FF);
  background: var(--lh-primary-soft, rgba(22, 119, 255, 0.08));
  border: 1rpx solid var(--lh-primary-line, rgba(22, 119, 255, 0.25));
}
.tts-btn--hover { opacity: 0.8; }
.tts-btn--on {
  color: var(--lh-danger, #F53F3F);
  background: var(--lh-danger-soft, rgba(245, 63, 63, 0.10));
  border-color: var(--lh-danger, #F53F3F);
  animation: ttsPulse 1.2s ease-in-out infinite;
}
@keyframes ttsPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

/* ---------- Markdown 富渲染（分段卡片 + 图标徽章装饰，明暗主题自适应） ---------- */
.md { margin: 2rpx 0; }
.md + .md { margin-top: 16rpx; }
.md-hd {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 14rpx 0 8rpx;
}
.md-hd:first-child { margin-top: 4rpx; }
.md-ico {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, var(--lh-primary, #1677FF), #5FB0FF);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(22, 119, 255, 0.35);
}
.md-t {
  font-size: 28rpx;
  font-weight: 650;
  color: var(--lh-text, #1B2129);
  letter-spacing: 0.5rpx;
}
.md-line {
  flex: 1;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, var(--lh-primary-line, rgba(22, 119, 255, 0.28)), transparent);
}
.md-lead {
  display: block;
  font-size: 27rpx;
  color: var(--lh-text, #1B2129);
  line-height: 1.6;
  margin: 2rpx 0 8rpx;
}
.md-li {
  display: flex;
  gap: 12rpx;
  padding: 7rpx 0;
  align-items: flex-start;
}
.md-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--lh-primary, #1677FF);
  margin-top: 15rpx;
  box-shadow: 0 0 0 4rpx rgba(22, 119, 255, 0.12);
}
.md-n {
  flex: none;
  min-width: 34rpx;
  height: 34rpx;
  margin-top: 5rpx;
  padding: 0 6rpx;
  border-radius: 10rpx;
  background: var(--lh-primary-soft, rgba(22, 119, 255, 0.08));
  color: var(--lh-primary, #1677FF);
  font-size: 20rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  font-variant-numeric: tabular-nums;
}
.md-tx {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.62;
  color: var(--lh-text, #1B2129);
  word-break: break-all;
}
.md-b {
  font-weight: 650;
  color: var(--lh-primary, #1677FF);
}
.md-end {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  opacity: 0.75;
}
.md-end-t {
  font-size: 20rpx;
  color: var(--lh-text-3, #9096A0);
  letter-spacing: 1rpx;
}
