.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}
.scene-bar {
  white-space: nowrap;
  background: var(--lh-card);
  padding: 16rpx 0 8rpx;
  border-bottom: 1rpx solid #EDEFF2;
}
.scene-list {
  display: inline-flex;
  padding: 0 24rpx;
}
.scene-pill {
  margin-right: 16rpx;
  white-space: nowrap;
}
.msgs {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}
.msg-row {
  display: flex;
  margin-bottom: 28rpx;
}
.msg-row.user {
  flex-direction: row-reverse;
}
.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3A8BFF, #1677FF);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.bubble {
  max-width: 78%;
  background: var(--lh-card);
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .05);
}
.bubble.user {
  background: #1677FF;
}
.bubble.user .txt {
  color: #FFFFFF;
}
.txt {
  font-size: 30rpx;
  line-height: 1.55;
  color: #1A1A1A;
  word-break: break-all;
  display: block;
}
.cards {
  margin-top: 20rpx;
}
.card {
  background: var(--lh-bg);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.c-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}
.c-sub {
  font-size: 24rpx;
  color: #646A73;
  margin-top: 8rpx;
  display: block;
}
.c-line {
  font-size: 24rpx;
  color: #646A73;
  margin-top: 8rpx;
  display: block;
  line-height: 1.5;
}
.c-save {
  font-size: 26rpx;
  color: #00B96B;
  font-weight: 600;
  margin-top: 12rpx;
  display: block;
}
.c-poi-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}
.c-poi-row:last-child {
  border-bottom: none;
}
.p-name {
  font-size: 26rpx;
  color: #1A1A1A;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.p-dist {
  font-size: 24rpx;
  color: #1677FF;
  margin-left: 16rpx;
}
.confirm-btn {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}
.actions {
  margin-top: 20rpx;
}
.act-btn {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.meta {
  margin-top: 16rpx;
}
.input-bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--lh-card);
  border-top: 1rpx solid #EDEFF2;
}
.care-toggle {
  width: 96rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: var(--lh-bg);
  color: #646A73;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.care-toggle.on {
  background: #EAF2FF;
  color: #1677FF;
  font-weight: 600;
}
.chat-input {
  flex: 1;
  height: 80rpx;
  background: var(--lh-bg);
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
}
.ph {
  color: #8F959E;
}
.mic-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #EAF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 16rpx;
  font-size: 32rpx;
  color: #1677FF;
  flex-shrink: 0;
}
.mic-btn.rec {
  background: #F5222D;
  color: #FFFFFF;
}
.send-btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: #1677FF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.send-btn.dis {
  background: #C8CDD4;
}

/* 录音状态条 */
.rec-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 32rpx;
  background: var(--lh-warning-soft);
  border-top: 1rpx solid var(--lh-warn-border);
}
.rec-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FA8C16;
  animation: rec-blink 1s infinite;
  flex-shrink: 0;
}
@keyframes rec-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}
.rec-text {
  font-size: 28rpx;
  color: #874D00;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 麦克风按钮（对话栏语音） ---------- */
.mic-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--lh-primary-soft);
  border: 1rpx solid var(--lh-glass-line);
}
.mic-btn--hover { opacity: 0.75; }
.mic-btn--rec {
  background: var(--lh-danger-soft, rgba(245, 34, 45, 0.12));
  border-color: var(--lh-danger);
  animation: micPulse 1.1s ease-in-out infinite;
}
.mic-ico { font-size: 30rpx; line-height: 1; }
@keyframes micPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}

/* ---------- 录音浮层 ---------- */
.rec-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 16, 28, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 90;
}
.rec-card {
  width: 100%;
  background: var(--lh-card-solid);
  border-radius: 28rpx 28rpx 0 0;
  padding: 44rpx 36rpx calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}
.rec-wave { display: flex; align-items: center; gap: 10rpx; height: 60rpx; }
.rec-bar {
  width: 8rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: var(--lh-primary);
  animation: waveBar 0.9s ease-in-out infinite;
}
.rec-bar:nth-child(2) { animation-delay: 0.12s; }
.rec-bar:nth-child(3) { animation-delay: 0.24s; }
.rec-bar:nth-child(4) { animation-delay: 0.36s; }
.rec-bar:nth-child(5) { animation-delay: 0.48s; }
@keyframes waveBar {
  0%, 100% { height: 20rpx; opacity: 0.55; }
  50% { height: 56rpx; opacity: 1; }
}
.rec-text {
  min-height: 44rpx;
  font-size: 30rpx;
  color: var(--lh-text);
  text-align: center;
  line-height: 1.55;
  max-width: 100%;
}
.rec-stop {
  padding: 16rpx 72rpx;
  border-radius: 999rpx;
  background: var(--lh-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
.rec-stop--hover { opacity: 0.85; }
