# git
.git
.gitignore

# 密钥与运行时数据：默认全部排除；
# 但构建镜像时需要把以下两个文件注入容器（二者都已放行入库，云托管能从仓库拿到）
**/.env
!03-lh-server/.env.cloud
03-lh-server/data/feedback.json
03-lh-server/data/logs/
03-lh-server/data/mcp.json
03-lh-server/data/quota.json
03-lh-server/data/sessions.json
03-lh-server/data/tokens.json
03-lh-server/data/voice.json
# 03-lh-server/data/models.json 不在排除列表 -> 会打进镜像（含云端模型 Key）

# 文档与截图（镜像不需要）
00-设计文档/
docs/

# 依赖与编译产物
node_modules/
**/node_modules/
unpackage/
**/unpackage/dist/

# 日志与系统文件
*.log
logs/
.DS_Store
Thumbs.db
