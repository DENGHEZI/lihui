# ============================================================
# 鲤慧 LiHui 服务端环境变量
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会上传）
# ============================================================

# ---------- 服务 ----------
PORT=8809
HOST=0.0.0.0
# 生产环境请设置为你的正式域名，用于 CORS
CORS_ORIGIN=*
LOG_LEVEL=info

# ---------- 百度地图（服务端 AK，绝不下发到客户端） ----------
BAIDU_AK=<你的百度服务端AK，百度控制台创建，类型=服务端>
#    ★ 多 AK 池（Key 掉线自愈）：支持逗号分隔多把钥匙，如 BAIDU_AK=ak1,ak2,ak3
#    某把钥匙日配额打满/被风控停用时，服务自动冷却它 10 分钟并切换下一把，
#    0 点配额重置后自动回归。诊断接口：GET /api/v1/map/ak-status
#    建议至少配 2 把（可在同一百度账号控制台创建多个「服务端」类型 AK）。
BAIDU_MAP_BASE=https://api.map.baidu.com
# 百度地图 Web 服务 API 默认返回 sn 校验关闭状态；如开启了 SN 校验请填 SK
BAIDU_SK=
# 浏览器端 AK(H5 底图 /map-home 专用):百度控制台单独创建「浏览器端」类型 AK,
# Referer 白名单锁定你的域名(如 *.lihui-tech.online/*)。泄露无害(白名单外调不通)、可独立重置。
# 留空时页面自动注入蜜罐 AK —— 扒页面的人拿到的是废钥匙。
BAIDU_AK_BROWSER=

# ---------- 安全与高并发(详见 src/utils/security.js) ----------
# 百度出站 QPS 上限(令牌桶):高并发时排队,防配额被瞬间打爆
BAIDU_QPS=30
# 蜜罐命中后的 IP 封禁时长(毫秒),默认 10 分钟
HONEYPOT_BAN_MS=600000
# ⚠️ 蜜罐密钥(honeytoken):下面这些是【故意放置的假密钥】,散布在 H5 页面与本模板中。
#    正常业务永远不该携带它们;谁拿它们请求本服务 → security.log 记录来源 + 封禁。
#    请勿删除,也【切勿】把它们填到 BAIDU_AK 等真实配置里(服务端会自检告警)。
#    示例(假):BAIDU_AK=vHk3mQ9pX2wR7tZ5nB8cL4dF6gS1aJ0e  ← 这把钥匙是假的
HONEYPOT_CANARY=vHk3mQ9pX2wR7tZ5nB8cL4dF6gS1aJ0e

# ---------- 大模型（留空则在端上「我的-模型设置」里配置） ----------
# 默认走 OpenAI 兼容协议，可指向 DeepSeek / 通义 / 智谱 / Ollama 等
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen-1.8B-instruct

# ---------- Token 配额 ----------
TOKEN_DAILY_QUOTA=200000

# ---------- MCP ----------
MCP_DIR=../04-lh-mcp-servers
MCP_AUTOSTART=true
MCP_MAX_RESTART=3

# ---------- 第三方语音（可选） ----------
VOICE_BAIDU_API_KEY=
VOICE_BAIDU_SECRET_KEY=
VOICE_AZURE_KEY=
VOICE_AZURE_REGION=eastasia

# ---------- 外卖平台「联网识别」（可选，详见 00-设计文档/06-真实价格接口接入指南.md） ----------
# ⚠️ 美团/饿了么/抖音【没有】公开店铺检索 API（需商户/渠道资质；爬取违规）。
#    因此「门店在不在外卖平台、什么价、什么评分」默认是【引导式识别】：每个门店挂各平台
#    「搜这家店」公开深链（前端引导用户去平台自查），不编造数据。
#    只有当你自配了 *_URL 真实接口，/shop/identify 才会真联网核实 onShelf/price/rating。
# 以下三个平台前缀：MEITUAN_ / ELEME_ / DOUYIN_，字段完全一致（以 MEITUAN_ 为例）：
# MEITUAN_APP_ID=           # 应用 ID（有商户号时填）
# MEITUAN_APP_KEY=          # 应用密钥
# MEITUAN_URL=              # 真实价格/在架查询接口（填了才启用联网核实）
# MEITUAN_METHOD=POST       # GET/POST，默认 POST
# MEITUAN_BODY={"keyword":"{{keyword}}","city":"{{city}}"}   # Body 模板，支持 {{keyword}}{{name}}{{city}}{{lng}}{{lat}}{{appId}}{{appKey}}{{sign}}
# MEITUAN_HEADERS={}        # 额外 Header（JSON）
# MEITUAN_AUTH=Bearer {{appKey}}   # 鉴权值
# MEITUAN_PRICE_PATH=data.price    # 返回里价格的 JSON 路径
# MEITUAN_RATING_PATH=data.rating  # 返回里评分的 JSON 路径（外卖识别用）
# MEITUAN_URL_PATH=data.url        # 返回里真实店铺页链接的 JSON 路径
# MEITUAN_TTL=300000        # 结果缓存毫秒，默认 5 分钟
# MEITUAN_SEARCH_URL=https://www.meituan.com/search/?query={{keyword}}  # 「搜这家店」公开深链（无商户号也能用，仅跳转）
# 饿了么 / 抖音：把前缀换成 ELEME_ / DOUYIN_，SEARCH_URL 默认：
#   ELEME_SEARCH_URL=https://www.ele.me/search/?keyword={{keyword}}
#   DOUYIN_SEARCH_URL=https://www.douyin.com/search/{{keyword}}?type=poi
# 携程（酒旅/门票，不参与外卖识别，模板同上用 CTROP_ 前缀）略。
